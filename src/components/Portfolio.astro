---
const projects = [
    {
        title: "E-commerce de Lujo",
        category: "PREMIUM RETAIL",
        description: "Plataforma de alta gama con experiencia inmersiva.",
        imageClass: "bg-dark",
    },
    {
        title: "Portfolio Creativo",
        category: "DESIGN STUDIO",
        description: "Exhibición minimalista para artistas digitales.",
        imageClass: "bg-cream",
    },
    {
        title: "Plataforma Interactiva",
        category: "WEB APP",
        description: "Interfaz fluida con micro-interacciones avanzadas.",
        imageClass: "bg-gray",
    },
    {
        title: "E-commerce de Lujo",
        category: "PREMIUM RETAIL",
        description: "Redefiniendo el lujo en el entorno digital.",
        imageClass: "bg-gradient",
    },
    {
        title: "Plataforma Intectiva",
        category: "TECH SOLUTIONS",
        description: "Ecosistema digital para empresas de vanguardia.",
        imageClass: "bg-dark",
    },
    {
        title: "Portforma de Lujo",
        category: "CORPORATE",
        description: "Soluciones elegantes para marcas exclusivas.",
        imageClass: "bg-cream",
    },
];

// Split projects into 3 columns for seamless loop
const col1 = [...projects, ...projects];
const col2 = [...projects.reverse(), ...projects.reverse()];
const col3 = [...projects, ...projects];
---

<section id="portafolio" class="portfolio">
    <div class="container">
        <div class="portfolio-header">
            <div class="header-left">
                <div class="tag-wrapper reveal-up">
                    <span class="tag">PORTAFOLIO</span>
                </div>
                <h2 class="reveal-up delay-1">
                    Proyectos <span>Seleccionados</span>
                </h2>
                <div class="line reveal-up delay-2"></div>
            </div>
            <p class="header-desc reveal-up delay-2">
                Una muestra de nuestro compromiso con el diseño de vanguardia y
                la excelencia técnica.
            </p>
        </div>

        <div class="gallery-reveal-layout">
            <div class="scrolling-wall-wrapper reveal-in delay-3">
                <div class="scroll-gradient top"></div>
                <div class="scroll-container">
                    <!-- Column 1: Up -->
                    <div class="scroll-column scroll-up delay-1">
                        {
                            col1.map((project) => (
                                <div class="project-frame">
                                    <div class="frame-inner">
                                        <div class="project-image">
                                            <div
                                                class={`image-placeholder ${project.imageClass}`}
                                            />
                                            <div class="project-overlay">
                                                <div class="project-info">
                                                    <h3>{project.title}</h3>
                                                </div>
                                                <a
                                                    href="#"
                                                    class="view-project"
                                                >
                                                    VER PROYECTO
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            ))
                        }
                    </div>

                    <!-- Column 2: Down -->
                    <div class="scroll-column scroll-down delay-2">
                        {
                            col2.map((project) => (
                                <div class="project-frame">
                                    <div class="frame-inner">
                                        <div class="project-image">
                                            <div
                                                class={`image-placeholder ${project.imageClass}`}
                                            />
                                            <div class="project-overlay">
                                                <div class="project-info">
                                                    <h3>{project.title}</h3>
                                                </div>
                                                <a
                                                    href="#"
                                                    class="view-project"
                                                >
                                                    VER PROYECTO
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            ))
                        }
                    </div>

                    <!-- Column 3: Up -->
                    <div class="scroll-column scroll-up delay-3">
                        {
                            col3.map((project) => (
                                <div class="project-frame">
                                    <div class="frame-inner">
                                        <div class="project-image">
                                            <div
                                                class={`image-placeholder ${project.imageClass}`}
                                            />
                                            <div class="project-overlay">
                                                <div class="project-info">
                                                    <h3>{project.title}</h3>
                                                </div>
                                                <a
                                                    href="#"
                                                    class="view-project"
                                                >
                                                    VER PROYECTO
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
                <div class="scroll-gradient bottom"></div>
            </div>

            <!-- Empty space to reveal the statue in the background -->
            <div class="reveal-space"></div>
        </div>
    </div>
</section>

<script>
    // Premium 3D Tilt Effect
    const frames = document.querySelectorAll(
        ".project-frame",
    ) as NodeListOf<HTMLElement>;

    frames.forEach((frame) => {
        frame.addEventListener("mousemove", (e) => {
            const rect = frame.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const rotateX = (y - centerY) / 25;
            const rotateY = (centerX - x) / 25;

            const inner = frame.querySelector(".frame-inner") as HTMLElement;
            if (inner) {
                inner.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
            }
        });

        frame.addEventListener("mouseleave", () => {
            const inner = frame.querySelector(".frame-inner") as HTMLElement;
            if (inner) {
                inner.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)`;
            }
        });
    });

    // Instant Reveal Logic for Portfolio
    const handleInstantReveal = () => {
        const portfolioSection = document.getElementById("portafolio");
        if (!portfolioSection) return;

        // Force all reveal elements in portfolio section to be visible immediately
        const reveals = portfolioSection.querySelectorAll(
            ".reveal, .reveal-up, .reveal-in, .delay-1, .delay-2, .delay-3",
        );

        reveals.forEach((el) => {
            el.classList.add("active");
        });
    };

    // Check on initial load if hash is #portafolio
    if (window.location.hash === "#portafolio") {
        handleInstantReveal();
    }

    // Listen for hash changes
    window.addEventListener("hashchange", () => {
        if (window.location.hash === "#portafolio") {
            handleInstantReveal();
        }
    });

    // Listen for clicks on links to #portafolio
    document.querySelectorAll('a[href="#portafolio"]').forEach((link) => {
        link.addEventListener("click", () => {
            handleInstantReveal();
        });
    });
</script>

<style>
    .portfolio {
        background-image: url("/museo.jpeg");
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        height: 100vh;
        display: flex;
        align-items: center;
        padding: 5rem 0;
        position: relative;
        z-index: 1;
        overflow: hidden;
    }

    .container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 4rem;
        width: 100%;
    }

    .portfolio-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 4rem;
        position: relative;
        z-index: 20;
    }

    .tag-wrapper {
        margin-bottom: 1.5rem;
    }

    .tag {
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        padding: 0.6rem 1.5rem;
        border: 1px solid rgba(0, 0, 0, 0.2);
        border-radius: 100px;
        color: rgba(0, 0, 0, 0.6);
        display: inline-block;
    }

    .header-left h2 {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 300;
        color: var(--color-black);
        margin-bottom: 1rem;
    }

    .header-left h2 span {
        font-weight: 400;
        font-style: italic;
        opacity: 0.7;
    }

    .line {
        width: 120px;
        height: 1px;
        background: var(--color-black);
    }

    .header-desc {
        max-width: 400px;
        color: var(--color-black);
        line-height: 1.6;
        font-weight: 300;
        text-align: right;
    }

    /* Reveal Layout: Carousel on the left, Space on the right */
    .gallery-reveal-layout {
        display: grid;
        grid-template-columns: 1fr 400px;
        gap: 4rem;
        align-items: center;
    }

    .scrolling-wall-wrapper {
        position: relative;
        height: 800px;
        overflow: hidden;
        mask-image: linear-gradient(
            to bottom,
            transparent,
            black 15%,
            black 85%,
            transparent
        );
    }

    .scroll-container {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        height: 100%;
    }

    .scroll-column {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .scroll-up {
        animation: scrollUp 40s linear infinite;
    }
    .scroll-down {
        animation: scrollDown 40s linear infinite;
    }

    @keyframes scrollUp {
        0% {
            transform: translateY(0);
        }
        100% {
            transform: translateY(-50%);
        }
    }

    @keyframes scrollDown {
        0% {
            transform: translateY(-50%);
        }
        100% {
            transform: translateY(0);
        }
    }

    /* Gradients */
    .scroll-gradient {
        position: absolute;
        left: 0;
        right: 0;
        height: 150px;
        z-index: 10;
        pointer-events: none;
    }
    .scroll-gradient.top {
        top: 0;
        background: linear-gradient(
            to bottom,
            rgba(219, 219, 219, 0.9),
            transparent
        );
    }
    .scroll-gradient.bottom {
        bottom: 0;
        background: linear-gradient(
            to top,
            rgba(219, 219, 219, 0.9),
            transparent
        );
    }

    /* Project Frames (The Gold Borders) */
    .project-frame {
        position: relative;
    }

    .frame-inner {
        position: relative;
        background: #000;
        border: 2px solid #b8a078;
        border-radius: 12px;
        overflow: hidden;
        aspect-ratio: 4/5;
        transition: transform 0.1s ease-out;
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
    }

    .project-image {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .image-placeholder {
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        filter: brightness(0.9);
    }

    .bg-dark {
        background-color: #1a1a1a;
    }
    .bg-cream {
        background-color: #e5e2db;
    }
    .bg-gray {
        background-color: #d1d1d1;
    }
    .bg-gradient {
        background: linear-gradient(135deg, #1a1a1a 0%, #333 100%);
    }

    .project-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.95) 0%,
            rgba(0, 0, 0, 0.4) 40%,
            transparent 100%
        );
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 2rem;
        opacity: 0.9;
    }

    .project-info h3 {
        font-size: 1.6rem;
        color: var(--color-cream);
        margin-bottom: 1rem;
        font-weight: 500;
        line-height: 1.2;
    }

    .view-project {
        color: #b8a078;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-decoration: none;
        border-bottom: 1px solid rgba(184, 160, 120, 0.3);
        padding-bottom: 0.2rem;
        width: max-content;
        opacity: 0;
        transform: translateY(10px);
        transition: all 0.3s ease;
    }

    .project-frame:hover .view-project {
        opacity: 1;
        transform: translateY(0);
    }

    @media (min-width: 1400px) {
        .portfolio {
            height: 110vh;
        }
        .container {
            padding: 0 3rem;
        }
        .portfolio-header {
            margin-bottom: 3rem;
        }
        .header-left h2 {
            font-size: clamp(2rem, 4vw, 3.5rem);
        }
        .scrolling-wall-wrapper {
            height: 700px;
        }
    }

    @media (max-width: 1200px) {
        .gallery-reveal-layout {
            grid-template-columns: 1fr;
        }
        .reveal-space {
            display: none;
        }
        .scroll-container {
            grid-template-columns: 1fr 1fr; /* 2 columns on tablet/small laptop */
            gap: 1.5rem;
        }
        .scroll-column:nth-child(3) {
            display: none;
        }
        .container {
            padding: 0 2rem;
        }
        .portfolio-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 1.5rem;
        }
        .header-desc {
            text-align: left;
            max-width: 100%;
        }
        .scrolling-wall-wrapper {
            height: 650px;
        }
    }

    @media (max-width: 768px) {
        .portfolio {
            height: 120vh;
        }
        .tag-wrapper {
            margin-top: 6rem;
        }
        .header-left {
            padding-top: 20px;
        }

        .portfolio {
            padding: 3rem 0;
        }
        .container {
            padding: 0 1.5rem;
        }
        .portfolio-header {
            margin-bottom: 2rem;
        }
        .header-left h2 {
            font-size: clamp(1.8rem, 6vw, 2.5rem);
        }
        .scroll-container {
            grid-template-columns: 1fr; /* 1 column on mobile */
        }
        .scroll-column:nth-child(2),
        .scroll-column:nth-child(3) {
            display: none; /* Hide 2nd and 3rd columns */
        }
        .scrolling-wall-wrapper {
            height: 550px;
        }
    }
</style>

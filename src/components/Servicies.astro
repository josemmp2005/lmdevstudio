<script>
    const section = document.querySelector(
        ".services-pin-section",
    ) as HTMLElement;
    const track = document.getElementById("services-track") as HTMLElement;

    if (section && track) {
        let isTicking = false;

        function updateScroll() {
            // Mobile check removed to enable horizontal scroll everywhere

            const sectionRect = section.getBoundingClientRect();
            const viewportHeight = window.innerHeight;
            const viewportWidth = window.innerWidth;
            const sectionHeight = section.offsetHeight;

            // Since margin-top is -100vh, the section starts "early".
            // We want to "wait" for that 100vh overlap to pass (fade transition)
            // before we start moving the horizontal track.
            const overlapBuffer = viewportHeight;

            const rawDistScrolled = -sectionRect.top;
            const effectiveDistScrolled = Math.max(
                0,
                rawDistScrolled - overlapBuffer,
            );

            // Recalculate max scroll based on remaining height
            const maxScrollDist =
                sectionHeight - viewportHeight - overlapBuffer;

            let progress = 0;
            if (maxScrollDist > 0) {
                progress = effectiveDistScrolled / maxScrollDist;
            }
            progress = Math.max(0, Math.min(1, progress));

            // Horizontal Translation
            const lastCard = track.lastElementChild as HTMLElement;
            const maxDelta = lastCard
                ? lastCard.offsetLeft
                : track.scrollWidth - viewportWidth;

            if (maxDelta > 0) {
                const translateX = progress * maxDelta;
                track.style.transform = `translate3d(-${translateX}px, 0, 0)`;
            }

            isTicking = false;
        }

        function onScroll() {
            if (!isTicking) {
                window.requestAnimationFrame(updateScroll);
                isTicking = true;
            }
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", () =>
            requestAnimationFrame(updateScroll),
        );
        updateScroll();
    }

    // Fade-in Observer
    const observerOptions = {
        threshold: 0.1,
        rootMargin: "0px 0px -100px 0px",
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
            }
        });
    }, observerOptions);

    const stickyWrapper = document.getElementById("sticky-services");
    if (stickyWrapper) {
        observer.observe(stickyWrapper);
    }
</script>

<style>
    .services-pin-section {
        height: 500vh;
        background-color: #0a0a0a;
        position: relative;
        color: #fff;
        margin-top: -100vh; /* Overlap with Hero */
        z-index: 1; /* Below Hero */
    }

    .sticky-wrapper {
        position: sticky;
        top: 0;
        height: 100vh;
        width: 100%;
        overflow: hidden;
        display: flex;
        align-items: center;
        /* Removed opacity: 0 and transform for immediate visibility */
    }

    /* Floating Header - Anchor effect */
    .fixed-title-container {
        position: absolute;
        top: 5rem;
        left: 0;
        width: 100%;
        z-index: 100;
        pointer-events: none;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 4rem;
    }

    .header-left h2 {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 300;
        line-height: 1.1;
        color: #fff;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .header-left h2 span {
        font-weight: 600;
        color: rgba(255, 255, 255, 0.4);
    }

    /* Horizontal Track */
    .horizontal-track-wrapper {
        width: 100%;
        height: 100%;
    }

    .horizontal-track {
        display: flex;
        height: 100%;
        width: max-content;
        will-change: transform;
    }

    /* Service Cards - FULL VH & VW */
    .service-card {
        width: 100vw;
        height: 100vh;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-right: 1px solid rgba(255, 255, 255, 0.03);
    }

    .card-inner {
        width: 100%;
        max-width: 1300px;
        margin-top: 5rem;
    }

    .card-content {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 10rem;
        align-items: center;
    }

    .content-left {
        display: flex;
        flex-direction: column;
    }

    .service-num {
        font-size: 12rem;
        font-weight: 700;
        line-height: 1;
        color: rgb(139 139 139);
        margin-left: -1rem;
        font-family: serif; /* Elegante contraste */
    }

    .content-left h3 {
        font-size: clamp(3.5rem, 7vw, 6rem);
        font-weight: 300;
        line-height: 0.95;
        margin-bottom: 3rem;
        color: #fff;
        letter-spacing: -0.02em;
    }

    .content-left h3 span {
        font-weight: 600;
        font-style: italic;
        color: rgba(255, 255, 255, 0.8);
    }

    .narrative {
        max-width: 500px;
    }

    .lead {
        font-size: 1.6rem;
        line-height: 1.5;
        color: #fff;
        margin-bottom: 2rem;
        font-weight: 500;
    }

    .body-text {
        font-size: 1.15rem;
        line-height: 1.8;
        color: rgba(255, 255, 255, 0.5);
        font-weight: 300;
    }

    /* Right column: detailed features */
    .feature-list {
        display: flex;
        flex-direction: column;
        gap: 5rem;
    }

    .feature-item h4 {
        font-size: 1.3rem;
        font-weight: 600;
        margin-bottom: 1.2rem;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        position: relative;
        padding-left: 2rem;
    }

    .feature-item h4::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.6em;
        width: 1rem;
        height: 1px;
        background: rgba(255, 255, 255, 0.4);
    }

    .feature-item p {
        font-size: 1.1rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.4);
        padding-left: 2rem;
    }

    .cta-banner {
        text-align: center;
        max-width: 900px;
        margin: 0 auto;
    }

    .cta-banner h2 {
        font-size: clamp(5rem, 10vw, 9rem);
        font-weight: 300;
        line-height: 0.9;
        margin-bottom: 3rem;
        letter-spacing: -0.03em;
    }

    .cta-banner h2 span {
        font-weight: 700;
        font-style: italic;
    }

    .cta-banner p {
        font-size: 1.8rem;
        color: rgba(255, 255, 255, 0.5);
        margin-bottom: 5rem;
        font-weight: 300;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
    }

    .btn-primary {
        display: inline-block;
        background: #fff;
        color: #000;
        padding: 1.8rem 5rem;
        border-radius: 100px;
        font-weight: 600;
        font-size: 1.2rem;
        text-decoration: none;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .btn-primary:hover {
        transform: translateY(-8px);
        box-shadow: 0 30px 60px rgba(255, 255, 255, 0.15);
        background: #f0f0f0;
    }

    @media (max-width: 1200px) {
        .card-content {
            gap: 5rem;
        }
        .service-card {
            padding: 0 5vw;
        }
    }

    @media (max-width: 1024px) {
        .feature-list {
            gap: 3rem;
        }
    }

    @media (max-width: 768px) {
        .btn-primary {
            padding: 1rem 2rem;
            font-size: 1rem;
        }
        .fixed-title-container {
            padding: 6rem 1.5rem 0;
        }

        .service-card {
            width: 100vw;
            height: 100vh;
            padding: 2rem 1.5rem;
        }

        .card-inner {
            margin-top: 0;
            display: flex;
            align-items: center;
        }

        .card-content {
            grid-template-columns: 1fr;
            gap: 2rem;
            text-align: left;
        }

        .content-right {
            display: none; /* Hide details on mobile to fit screen/card */
        }

        .service-num {
            font-size: 6rem;
            margin-bottom: -1rem;
        }

        .content-left h3 {
            font-size: 3rem;
            margin-bottom: 1.5rem;
        }

        .lead {
            font-size: 1.2rem;
            margin-bottom: 1rem;
        }

        .body-text {
            font-size: 1rem;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 5;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .cta-banner h2 {
            font-size: 3.5rem;
        }

        .cta-banner p {
            font-size: 1.2rem;
            margin-bottom: 3rem;
        }
    }
</style>

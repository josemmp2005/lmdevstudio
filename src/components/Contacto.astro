---

<section id="contacto" class="contact">
    <div class="container">
        <div class="contact-grid">
            <div class="contact-info">
                <div class="tag-wrapper reveal-up">
                    <span class="tag">CONTACTO</span>
                </div>
                <h2 class="reveal-up delay-1">
                    ¿Tienes un <span>Proyecto</span> en Mente?
                </h2>
                <div class="line reveal-up delay-2"></div>

                <p class="description reveal-up delay-3">
                    Estamos listos para escucharte y convertir tus ideas en
                    realidades digitales excepcionales.
                </p>

                <div class="contact-details">
                    <div class="detail-item reveal-up delay-4">
                        <span class="label">Email</span>
                        <a href="mailto:hola@lmdevstudio.com" class="value"
                            >hola@lmdevstudio.com</a
                        >
                    </div>
                    <div class="detail-item reveal-up delay-5">
                        <span class="label">Ubicación</span>
                        <span class="value"
                            >Madrid, España — Remoto en todo el mundo</span
                        >
                    </div>
                    <div class="detail-item reveal-up delay-5">
                        <span class="label">Social</span>
                        <div class="social-links">
                            <a href="#">Instagram</a>
                            <a href="#">LinkedIn</a>
                            <a href="#">Behance</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contact-form-container reveal-in delay-2">
                <form class="contact-form" id="contactForm">
                    <div class="form-group">
                        <label for="name">Nombre</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Tu nombre"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="tu@email.com"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label for="message">Mensaje</label>
                        <textarea
                            id="message"
                            name="message"
                            rows="5"
                            placeholder="Cuéntanos sobre tu proyecto..."
                            required></textarea>
                    </div>
                    <button
                        type="submit"
                        class="btn-apple btn-apple-fill btn-submit"
                    >
                        ENVIAR MENSAJE
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="arrow"
                            ><line x1="5" y1="12" x2="19" y2="12"
                            ></line><polyline points="12 5 19 12 12 19"
                            ></polyline></svg
                        >
                    </button>
                </form>
            </div>
        </div>

        <!-- Integrated Footer -->
        <div class="footer-bar">
            <div class="copyright">
                &copy; {new Date().getFullYear()} lmdevstudio. Todos los derechos
                reservados.
            </div>
            <div class="legal-links">
                <a href="/aviso-legal">Aviso Legal</a>
                <a href="/politica-privacidad">Política de Privacidad</a>
                <a href="/politica-cookies">Política de Cookies</a>
            </div>
        </div>
    </div>
</section>

<script>
    const form = document.getElementById("contactForm") as HTMLFormElement;
    if (form) {
        form.addEventListener("submit", (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const name = formData.get("name");
            const email = formData.get("email");
            const message = formData.get("message");

            const subject = `Nuevo mensaje de ${name} desde la web`;
            const body = `Nombre: ${name}\nEmail: ${email}\n\nMensaje:\n${message}`;

            const mailtoLink = `lmdevstudio@outlook.es?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

            window.location.href = mailtoLink;
        });
    }
    // Instant Reveal Logic for Contact
    const handleInstantReveal = () => {
        const contactSection = document.getElementById("contacto");
        if (!contactSection) return;

        // Force all reveal elements in contact section to be visible immediately
        const reveals = contactSection.querySelectorAll(
            ".reveal, .reveal-up, .reveal-in, .delay-1, .delay-2, .delay-3, .delay-4, .delay-5",
        );

        reveals.forEach((el) => {
            el.classList.add("active");
        });
    };

    // Check on initial load if hash is #contacto
    if (window.location.hash === "#contacto") {
        handleInstantReveal();
    }

    // Listen for hash changes
    window.addEventListener("hashchange", () => {
        if (window.location.hash === "#contacto") {
            handleInstantReveal();
        }
    });

    // Listen for clicks on links to #contacto
    document.querySelectorAll('a[href="#contacto"]').forEach((link) => {
        link.addEventListener("click", () => {
            handleInstantReveal();
        });
    });
</script>

<style>
    .contact {
        height: 100vh;
        align-content: center;
        background-image: url("/oficina.png");
        background-size: cover;
        background-position: center;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 2rem;
        width: 100%;
        display: flex;
        flex-direction: column;
        height: 100%;
        justify-content: center;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 8rem;
        flex-grow: 1;
        align-content: center;
    }

    .tag-wrapper {
        margin-bottom: 2rem;
    }

    .tag {
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        padding: 0.6rem 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 100px;
        color: rgba(255, 255, 255, 0.6);
    }

    h2 {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 300;
        line-height: 1.1;
        margin-bottom: 2rem;
        color: #d3bc7c;
    }

    h2 span {
        font-weight: 500;
        font-style: italic;
    }

    .line {
        width: 80px;
        height: 1px;
        background: #d3bc7c;
        margin-bottom: 2.5rem;
    }

    .mascot-container {
        margin-bottom: 2rem;
        display: flex;
        justify-content: flex-start;
    }

    .description {
        font-size: 1.2rem;
        line-height: 1.7;
        color: #ffffff;
        margin-bottom: 4rem;
    }

    .contact-details {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .detail-item .label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #b8b8b8;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .detail-item .value {
        font-size: 1.1rem;
        color: #ffffff;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .detail-item a.value:hover {
        color: #d3bc7c;
    }

    .social-links {
        display: flex;
        gap: 1.5rem;
    }

    .social-links a {
        font-size: 1rem;
        color: #ffffff;
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.3s ease;
    }

    .social-links a:hover {
        border-color: #d3bc7c;
    }

    /* Form Styles */
    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .form-group label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #ffffff;
    }

    .form-group input,
    .form-group textarea {
        background: transparent;
        border: none;
        border-bottom: 1px solid #d3bc7c;
        padding: 1rem 0;
        font-family: inherit;
        font-size: 1.1rem;
        color: #d3bc7c;
        transition: border-color 0.3s ease;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: #d3bc7c;
    }

    .btn-submit {
        margin-top: 2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        background: var(--color-black);
        color: var(--color-cream);
        padding: 1.5rem 3rem;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        cursor: pointer;
        transition:
            transform 0.3s ease,
            opacity 0.3s ease;
    }

    .btn-submit:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }

    .btn-submit .arrow {
        width: 1.2rem;
        height: 1.2rem;
        transition: transform 0.3s ease;
    }

    .btn-submit:hover .arrow {
        transform: translateX(5px);
    }

    .form-status {
        margin-top: 1rem;
        font-size: 0.9rem;
        font-weight: 500;
        min-height: 1.5rem;
        transition: opacity 0.3s ease;
        opacity: 0;
    }

    .footer-bar {
        margin-top: auto; /* Push to bottom */
        padding-top: 4rem;
        padding-bottom: 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.4);
    }

    .legal-links {
        display: flex;
        gap: 2rem;
    }

    .legal-links a {
        color: rgba(255, 255, 255, 0.4);
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .legal-links a:hover {
        color: #d3bc7c;
    }

    @media (max-width: 1024px) {
        .contact-grid {
            gap: 5rem;
        }
    }

    @media (max-width: 768px) {
        .contact {
            padding: 2rem 0; /* Reduced padding as flex handles spacing */
            height: auto;
            min-height: 100vh;
        }
        .contact-grid {
            grid-template-columns: 1fr;
            gap: 4rem;
            margin-bottom: 4rem;
        }
        .description {
            margin-bottom: 3rem;
        }
        .footer-bar {
            flex-direction: column;
            gap: 1.5rem;
            text-align: center;
            padding-top: 2rem;
        }
        .legal-links {
            flex-direction: column;
            gap: 1rem;
        }
    }
</style>

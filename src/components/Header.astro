---

<header class="header" id="main-header">
    <div class="container">
        <div class="logo-wrapper">
            <a href="/" class="logo">
                <img src="/logo.png" alt="" class="logo-img" />
            </a>
        </div>

        <nav class="nav">
            <div id="nav-indicator" class="nav-indicator"></div>
            <ul>
                <li><a href="#servicios">Servicios</a></li>
                <li><a href="#nosotros">Nosotros</a></li>
                <li><a href="#portafolio">Portafolio</a></li>
                <li><a href="#contacto">Contacto</a></li>
            </ul>
        </nav>

        <div class="cta-wrapper">
            <a href="#presupuestos" class="btn-presupuestos">Presupuestos</a>
        </div>
    </div>
</header>

<script>
    const header = document.getElementById("main-header");
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll(".nav a");
    const indicator = document.getElementById("nav-indicator");

    function updateIndicator() {
        const activeLink = document.querySelector(
            ".nav a.active",
        ) as HTMLElement;
        if (activeLink && indicator && header?.classList.contains("scrolled")) {
            const linkRect = activeLink.getBoundingClientRect();
            const navRect = activeLink.closest(".nav")!.getBoundingClientRect();

            indicator.style.width = `${linkRect.width + 30}px`;
            indicator.style.height = `${linkRect.height + 15}px`;
            indicator.style.left = `${linkRect.left - navRect.left - 15}px`;
            indicator.style.top = `${linkRect.top - navRect.top - 7.5}px`;
            indicator.style.opacity = "1";
        } else if (indicator) {
            indicator.style.opacity = "0";
        }
    }

    // Scroll Logic for Pill Effect
    window.addEventListener("scroll", () => {
        if (window.scrollY > 50) {
            header?.classList.add("scrolled");
        } else {
            header?.classList.remove("scrolled");
        }
        updateIndicator();
    });

    // Scrollspy Logic
    const observerOptions = {
        root: null,
        rootMargin: "-40% 0px -40% 0px",
        threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                const id = entry.target.getAttribute("id");
                navLinks.forEach((link) => {
                    link.classList.toggle(
                        "active",
                        link.getAttribute("href") === `#${id}`,
                    );
                });
                updateIndicator();
            }
        });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));

    window.addEventListener("resize", updateIndicator);

    // Initial check
    setTimeout(updateIndicator, 100);
</script>

<style>
    .header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        background-color: transparent;
        z-index: 9999;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        justify-content: center;
        padding: 1.5rem 0;
    }

    /* Estilos cuando se hace scroll - Efecto Píldora */
    .header.scrolled {
        top: 1.5rem;
        width: auto;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(26, 26, 26, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 100px;
        padding: 0.5rem 1rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .container {
        padding: 0 3rem;
        width: 100%;
        max-width: var(--max-width);
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        transition: all 0.4s ease;
    }

    .header.scrolled .container {
        padding: 0.5rem 1.5rem;
        gap: 3rem;
        width: max-content;
    }

    .logo-img {
        width: 130px;
        transition: all 0.4s ease;
    }

    .header.scrolled .logo-img {
        width: 100px; /* Un poco más pequeño en modo píldora */
        filter: brightness(0) invert(1); /* Máscara blanca */
    }

    .nav {
        position: relative;
        display: flex;
        align-items: center;
    }

    .nav-indicator {
        position: absolute;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 100px;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        pointer-events: none;
        z-index: 0;
        opacity: 0;
        will-change: transform, width, left;
    }

    .nav ul {
        display: flex;
        gap: 3.5rem;
        transition: all 0.4s ease;
        position: relative;
        z-index: 1;
    }

    .header.scrolled .nav ul {
        gap: 2rem;
    }

    .nav a {
        font-size: 1.25rem;
        font-weight: 400;
        color: var(--color-black);
        opacity: 0.8;
        transition: all 0.3s ease;
    }

    .header.scrolled .nav a {
        color: var(--color-cream);
        font-size: 1rem;
        opacity: 0.9;
    }

    .nav a:hover,
    .nav a.active {
        opacity: 1;
    }

    .header.scrolled .nav a.active {
        color: #fff;
        opacity: 1;
        font-weight: 500;
    }

    /* Ocultar indicador si no estamos en modo scrolled si se prefiere */
    .header:not(.scrolled) .nav-indicator {
        display: none;
    }

    .btn-presupuestos {
        font-size: 1.05rem;
        font-weight: 400;
        opacity: 0.8;
        padding: 0.5rem 0;
        border-bottom: 1px solid transparent;
        transition: all 0.3s ease;
    }

    .header.scrolled .btn-presupuestos {
        color: var(--color-cream);
        font-size: 0.95rem;
        background: rgba(255, 255, 255, 0.1);
        padding: 0.6rem 1.5rem;
        border-radius: 50px;
        border-bottom: none;
    }

    .btn-presupuestos:hover {
        opacity: 1;
        border-bottom-color: var(--color-black);
    }

    .header.scrolled .btn-presupuestos:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    @media (max-width: 1024px) {
        .container {
            padding: 0 2rem;
        }
        .nav {
            display: none;
        }
        .header.scrolled {
            width: 90%;
            padding: 0.8rem 1rem;
        }
        .header.scrolled .container {
            width: 100%;
            padding: 0;
        }
    }
</style>

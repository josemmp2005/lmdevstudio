---

---

<header class="header" id="main-header">
    <div class="container">
        <div class="logo-wrapper">
            <a href="/" class="logo">
                <img src="/logo.webp" alt="" class="logo-img" />
            </a>
        </div>

        <nav class="nav">
            <div id="nav-indicator" class="nav-indicator"></div>
            <ul>
                <li><a href="#servicios">Servicios</a></li>
                <li><a href="#nosotros">Nosotros</a></li>
                <li><a href="#portafolio">Portafolio</a></li>
                <li><a href="#contacto">Contacto</a></li>
            </ul>
        </nav>

        <!-- Mobile Toggle -->
        <div class="mobile-toggle" id="mobile-toggle">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </div>
    </div>
</header>

<!-- Mobile Overlay moved outside header to avoid transform stacking context issues -->
<div class="mobile-menu-overlay" id="mobile-menu">
    <a href="#servicios" class="mobile-nav-link">Servicios</a>
    <a href="#nosotros" class="mobile-nav-link">Nosotros</a>
    <a href="#portafolio" class="mobile-nav-link">Portafolio</a>
    <a href="#contacto" class="mobile-nav-link">Contacto</a>
</div>

<script>
    const header = document.getElementById("main-header");
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll(".nav a");
    const indicator = document.getElementById("nav-indicator");

    function updateIndicator() {
        const activeLink = document.querySelector(
            ".nav a.active",
        ) as HTMLElement;
        if (activeLink && indicator && header?.classList.contains("scrolled")) {
            const linkRect = activeLink.getBoundingClientRect();
            const navRect = activeLink.closest(".nav")!.getBoundingClientRect();

            indicator.style.width = `${linkRect.width + 30}px`;
            indicator.style.height = `${linkRect.height + 15}px`;
            indicator.style.left = `${linkRect.left - navRect.left - 15}px`;
            indicator.style.top = `${linkRect.top - navRect.top - 7.5}px`;
            indicator.style.opacity = "1";
        } else if (indicator) {
            indicator.style.opacity = "0";
        }
    }

    // Scroll Logic for Pill Effect - Solo se activa al llegar a Servicios
    window.addEventListener("scroll", () => {
        const serviciosSection = document.getElementById("servicios");
        if (serviciosSection) {
            const rect = serviciosSection.getBoundingClientRect();
            // Se activa cuando la sección de servicios llega arriba
            if (rect.top <= 100) {
                header?.classList.add("scrolled");
            } else {
                header?.classList.remove("scrolled");
            }
        }
        updateIndicator();
    });

    // Scrollspy & Theme Logic
    const sectionVisibility = new Map();

    const observerOptions = {
        root: null,
        rootMargin: "-25% 0px -70% 0px", // Trigger when section is in top-mid area
        threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            sectionVisibility.set(
                entry.target.getAttribute("id"),
                entry.isIntersecting,
            );
        });

        // Determine active section (latest intersecting section in DOM order)
        let activeId = "";
        sections.forEach((s) => {
            if (sectionVisibility.get(s.id)) activeId = s.id;
        });

        if (activeId) {
            // Apply Special themes
            header?.classList.remove(
                "is-portfolio",
                "is-nosotros",
                "is-contacto",
            );

            if (activeId === "portafolio") {
                header?.classList.add("is-portfolio");
            } else if (activeId === "nosotros") {
                header?.classList.add("is-nosotros");
            } else if (activeId === "contacto") {
                header?.classList.add("is-contacto");
            }

            // Update Nav Links
            navLinks.forEach((link) => {
                const isActive = link.getAttribute("href") === `#${activeId}`;
                link.classList.toggle("active", isActive);
            });

            updateIndicator();
        }
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));

    window.addEventListener("resize", updateIndicator);

    // Initial check
    setTimeout(updateIndicator, 100);

    // Logo smooth scroll
    const logoLink = document.querySelector(".logo");
    logoLink?.addEventListener("click", (e) => {
        if (
            window.location.pathname === "/" ||
            window.location.pathname === "/index.html"
        ) {
            e.preventDefault();
            window.scrollTo({
                top: 0,
                behavior: "smooth",
            });
            history.pushState(null, "", "/");
        }
    });

    // Mobile Menu Logic
    const toggle = document.getElementById("mobile-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    if (toggle && header && mobileMenu) {
        toggle.addEventListener("click", () => {
            header.classList.toggle("menu-open");
            mobileMenu.classList.toggle("active");
            const isOpen = header.classList.contains("menu-open");
            document.body.style.overflow = isOpen ? "hidden" : "";
        });

        const closeMenu = () => {
            header.classList.remove("menu-open");
            mobileMenu.classList.remove("active");
            document.body.style.overflow = "";
        };

        // Helper to get true offset top relative to document
        const getOffsetTop = (element: HTMLElement | null) => {
            let distance = 0;
            while (element) {
                distance += element.offsetTop;
                element = element.offsetParent as HTMLElement | null;
            }
            return distance;
        };

        // Close menu when clicking a link and smooth scroll
        const allLinks = document.querySelectorAll('a[href^="#"]');
        allLinks.forEach((link) => {
            link.addEventListener("click", (e) => {
                e.preventDefault();
                const targetId = link.getAttribute("href");
                if (targetId && targetId !== "#") {
                    const targetElement = document.querySelector(targetId);
                    if (targetElement) {
                        // Use offsetTop to get the layout position, avoiding sticky/fixed confusion
                        const offsetPosition = getOffsetTop(
                            targetElement as HTMLElement,
                        );

                        window.scrollTo({
                            top: offsetPosition,
                            behavior: "smooth",
                        });

                        // Update URL hash manually
                        history.pushState(null, "", targetId);

                        // Close menu if open (mobile)
                        closeMenu();
                    }
                }
            });
        });
    }
</script>

<style>
    .header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        background-color: transparent;
        z-index: 10001; /* Higher than mobile overlay (10000) */
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        justify-content: center;
        padding: 1.5rem 0;
    }

    /* Estilos cuando se hace scroll - Efecto Píldora */
    .header.scrolled {
        top: 1.5rem;
        width: auto;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(26, 26, 26, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 100px;
        padding: 0.5rem 1rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    /* Estilo específico para PORTAFOLIO */
    .header.scrolled.is-portfolio {
        background: rgba(250, 249, 246, 0.45);
        border: 1px solid rgba(0, 0, 0, 0.05);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }

    /* Estilo específico para NOSOTROS */
    .header.scrolled.is-nosotros {
        background: #1f130e;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    /* Estilo específico para CONTACTO (basado en imagen) */
    .header.scrolled.is-contacto {
        background: rgba(
            36,
            42,
            49,
            0.85
        ); /* Un tono oscuro azulado/grisáceo como la imagen */
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    }

    .container {
        padding: 0 3rem;
        width: 100%;
        max-width: var(--max-width);
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        transition: all 0.4s ease;
    }

    .header.scrolled .container {
        padding: 0.5rem 1rem 0.5rem 1.5rem;
        gap: 2.5rem;
        width: max-content;
    }

    .logo-img {
        width: 130px;
        transition: all 0.4s ease;
    }

    .header.scrolled .logo-img {
        width: 90px;
        filter: brightness(0) invert(1);
    }

    .header.scrolled.is-portfolio .logo-img {
        filter: none;
    }

    .nav {
        position: relative;
        display: flex;
        align-items: center;
    }

    .nav-indicator {
        position: absolute;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 100px;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        pointer-events: none;
        z-index: 0;
        opacity: 0;
        will-change: transform, width, left;
    }

    .header.scrolled.is-portfolio .nav-indicator {
        background: #fff;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .nav ul {
        display: flex;
        gap: 3.5rem;
        transition: all 0.4s ease;
        position: relative;
        z-index: 1;
    }

    .header.scrolled .nav ul {
        gap: 1.8rem;
    }

    .nav a {
        font-size: 1.25rem;
        font-weight: 400;
        color: var(--color-black);
        opacity: 0.8;
        transition: all 0.3s ease;
        position: relative;
        display: inline-block;
    }

    .header.scrolled .nav a {
        color: var(--color-cream);
        font-size: 0.95rem;
        opacity: 0.7;
    }

    .header.scrolled.is-portfolio .nav a {
        color: var(--color-black);
        opacity: 0.6;
    }

    .nav a:hover,
    .nav a.active {
        opacity: 1 !important;
    }

    .header.scrolled .nav a.active {
        color: #fff;
        font-weight: 500;
    }

    /* Estilo de enlace activo para CONTACTO (Subrayado dorado) */
    .header.scrolled.is-contacto .nav a.active {
        color: #c5a363; /* Dorado elegante */
    }

    /* Botón Presupuestos en Header */
    .header-actions {
        display: flex;
        align-items: center;
        opacity: 0;
        visibility: hidden;
        transform: translateX(10px);
        transition: all 0.4s ease;
    }

    .header.scrolled .header-actions {
        opacity: 1;
        visibility: visible;
        transform: translateX(0);
    }

    .btn-presupuestos {
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        padding: 0.6rem 1.4rem;
        border-radius: 100px;
        font-size: 0.9rem;
        font-weight: 500;
        border: 1px solid rgba(255, 255, 255, 0.15);
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-presupuestos:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.3);
        transform: translateY(-1px);
    }

    .header.scrolled.is-portfolio .btn-presupuestos {
        background: rgba(0, 0, 0, 0.03);
        color: var(--color-black);
        border-color: rgba(0, 0, 0, 0.1);
    }

    .header.scrolled.is-portfolio .nav a.active {
        color: var(--color-black);
        font-weight: 600;
    }

    /* Ocultar indicador si no estamos en modo scrolled si se prefiere */
    .header:not(.scrolled) .nav-indicator {
        display: none;
    }

    /* Mobile Menu Toggle */
    .mobile-toggle {
        display: none;
        flex-direction: column;
        gap: 6px;
        cursor: pointer;
        z-index: 10001; /* Above menu overlay */
        padding: 0.5rem;
    }

    .bar {
        width: 30px;
        height: 2px;
        background-color: var(--color-black);
        transition: all 0.3s ease;
    }

    .header.scrolled .bar {
        background-color: var(--color-cream);
    }

    .header.scrolled.is-portfolio .bar {
        background-color: var(--color-black);
    }

    /* Toggled State overrides */
    .header.menu-open .logo-wrapper {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .header.menu-open.scrolled {
        background: transparent;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        border-color: transparent;
        box-shadow: none;
    }

    /* Toggled State (X shape) */
    .header.menu-open .bar:nth-child(1) {
        transform: translateY(8px) rotate(45deg);
        background-color: var(--color-black); /* Always black on open menu */
    }

    .header.menu-open .bar:nth-child(2) {
        opacity: 0;
    }

    .header.menu-open .bar:nth-child(3) {
        transform: translateY(-8px) rotate(-45deg);
        background-color: var(--color-black);
    }

    .header.menu-open.scrolled .bar {
        background-color: var(
            --color-black
        ); /* Override scrolled color when open */
    }

    /* Mobile Overlay */
    .mobile-menu-overlay {
        position: fixed;
        inset: 0;
        background-color: var(--color-cream);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        z-index: 10;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s ease;
    }

    .mobile-menu-overlay.active {
        opacity: 1;
        pointer-events: auto;
    }

    .mobile-nav-link {
        font-size: 2rem;
        font-weight: 300;
        color: var(--color-black);
        text-decoration: none;
        transform: translateY(20px);
        opacity: 0;
        transition: all 0.4s ease;
    }

    .mobile-menu-overlay.active .mobile-nav-link {
        transform: translateY(0);
        opacity: 1;
    }

    /* Stagger delays for links */
    .mobile-menu-overlay.active .mobile-nav-link:nth-child(1) {
        transition-delay: 0.1s;
    }
    .mobile-menu-overlay.active .mobile-nav-link:nth-child(2) {
        transition-delay: 0.2s;
    }
    .mobile-menu-overlay.active .mobile-nav-link:nth-child(3) {
        transition-delay: 0.3s;
    }
    .mobile-menu-overlay.active .mobile-nav-link:nth-child(4) {
        transition-delay: 0.4s;
    }

    @media (max-width: 1024px) {
        .container {
            padding: 0 2rem;
        }
        .nav {
            display: none;
        }
        .mobile-toggle {
            display: flex;
        }
        .header.scrolled {
            width: 90%;
            padding: 0.8rem 1rem;
            justify-content: space-between; /* Ensure logo and toggle are spaced */
        }
        .header.scrolled .container {
            width: 100%;
            padding: 0;
            justify-content: space-between;
        }
    }
</style>


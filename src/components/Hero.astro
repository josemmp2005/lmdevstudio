---
import fs from "node:fs";
import path from "node:path";

// Get sorted list of frame files from public/images/hero
const heroImagesDir = path.join(process.cwd(), "public", "images", "hero");
let frameFiles: string[] = [];
try {
    frameFiles = fs
        .readdirSync(heroImagesDir)
        .filter(
            (file: string) => file.endsWith(".png") || file.endsWith(".jpg"),
        )
        .sort();
} catch (e) {
    console.error("Could not read hero images directory:", e);
}

// Pass frames to client
const framesJson = JSON.stringify(frameFiles);
---

<section class="hero-spacer">
    <div class="sticky-container">
        <canvas id="hero-canvas"></canvas>

        <!-- Contenedor del texto que se desvanecerá -->
        <div class="hero-content-wrapper" id="hero-content-wrapper">
            <div class="hero-container">
                <div class="hero-content">
                    <div class="tag-wrapper">
                        <span class="tag">PREMIUM WEB DEVELOPMENTS</span>
                    </div>

                    <h1>
                        Creamos <span>Experiencias</span> Digitales de <strong
                            >Alto Nivel</strong
                        >
                    </h1>

                    <p class="description">
                        Diseño y desarrollo web con enfoque en rendimiento, SEO
                        y conversión para marcas que se toman en serio su
                        presencia digital.
                    </p>

                    <div class="hero-actions">
                        <a
                            href="#contacto"
                            class="btn-apple btn-apple-fill btn-primary"
                            >Hablemos</a
                        >
                        <a
                            href="#proyectos"
                            class="btn-apple btn-apple-tinted btn-secondary"
                            >Nuestros Proyectos</a
                        >
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script define:vars={{ framesJson }}>
    // Configuration
    const frames = JSON.parse(framesJson);
    const canvas = document.getElementById("hero-canvas");
    const container = document.querySelector(".sticky-container"); // Sticky wrapper

    if (canvas && container) {
        const context = canvas.getContext("2d");
        const heroSpacer = document.querySelector(".hero-spacer");
        const heroContent = document.getElementById("hero-content-wrapper");
        const stickyContainer = document.querySelector(".sticky-container");

        // Preload images
        const images = [];
        let imagesLoaded = 0;

        const preloadImages = () => {
            frames.forEach((filename, index) => {
                const img = new Image();
                img.src = `/images/hero/${filename}`;
                img.onload = () => {
                    imagesLoaded++;
                    if (index === 0) {
                        // Draw first frame immediately when it loads
                        requestAnimationFrame(() => updateImage(0));
                    }
                };
                images[index] = img;
            });
        };

        // Drawing Logic
        const updateImage = (index) => {
            if (
                index >= 0 &&
                index < images.length &&
                images[index] &&
                images[index].complete
            ) {
                const img = images[index];

                // Canvas dimensions
                const canvasFullWidth = window.innerWidth;
                const canvasFullHeight = window.innerHeight;

                if (
                    canvas.width !== canvasFullWidth ||
                    canvas.height !== canvasFullHeight
                ) {
                    canvas.width = canvasFullWidth;
                    canvas.height = canvasFullHeight;
                }

                // "cover" fit logic
                const canvasRatio = canvas.width / canvas.height;
                const imgRatio = img.width / img.height;

                let drawWidth, drawHeight, offsetX, offsetY;

                if (imgRatio > canvasRatio) {
                    drawHeight = canvas.height;
                    drawWidth = img.width * (canvas.height / img.height);
                    offsetX = (canvas.width - drawWidth) / 2;
                    offsetY = 0;
                } else {
                    drawWidth = canvas.width;
                    drawHeight = img.height * (canvas.width / img.width);
                    offsetX = 0;
                    offsetY = (canvas.height - drawHeight) / 2;
                }

                context.clearRect(0, 0, canvas.width, canvas.height);
                context.drawImage(img, offsetX, offsetY, drawWidth, drawHeight);
            }
        };

        // Scroll Logic
        const getScrollProgress = () => {
            if (!heroSpacer) return 0;
            const rect = heroSpacer.getBoundingClientRect();
            // Scroll distance
            const scrollDistance = rect.height - window.innerHeight;
            const scrolled = -rect.top;

            const progress = scrolled / scrollDistance;
            return Math.max(0, Math.min(1, progress));
        };

        const onScroll = () => {
            const progress = getScrollProgress();

            // 1. Frame Animation (Stops at 85%)
            const frameProgressLimit = 0.85;
            const frameRatio = Math.min(1, progress / frameProgressLimit);
            const frameIndex = Math.min(
                frames.length - 1,
                Math.floor(frameRatio * frames.length),
            );
            requestAnimationFrame(() => updateImage(frameIndex));

            // 2. Text Opacity (First 15%)
            if (heroContent) {
                const fadeProgress = progress * 6;
                const textOpacity = 1 - Math.min(1, fadeProgress);
                heroContent.style.opacity = textOpacity;
                heroContent.style.pointerEvents =
                    textOpacity <= 0.05 ? "none" : "all";
            }

            // 3. Reveal Services (Fade Out Hero) - Last 15%
            if (stickyContainer) {
                const fadeStart = 0.85;
                if (progress > fadeStart) {
                    // Map 0.85 -> 1.0 to Opacity 1 -> 0
                    const remaining = 1 - progress;
                    const range = 1 - fadeStart;
                    const opacity = Math.max(0, remaining / range);
                    stickyContainer.style.opacity = opacity;
                } else {
                    stickyContainer.style.opacity = 1;
                }
            }
        };

        window.addEventListener("resize", () => {
            onScroll();
        });
        window.addEventListener("scroll", onScroll, { passive: true });

        preloadImages();
        onScroll();
    }
</script>

<style>
    .hero-spacer {
        height: 500vh;
        position: relative;
        z-index: 10; /* Higher than Services */
    }

    .sticky-container {
        position: sticky;
        top: 0;
        height: 100vh;
        width: 100%;
        overflow: hidden;
    }

    canvas {
        display: block;
        width: 100%;
        height: 100%;
        transition: opacity 0.1s linear;
    }

    .hero-content-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        z-index: 10;
        will-change: opacity;
    }

    .hero-container {
        width: 100%;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 2rem;
    }

    .hero-content {
        max-width: 600px;
        text-align: left !important;
    }

    /* Keep existing hero styles */
    .tag-wrapper {
        margin-bottom: 3rem;
        animation: reveal 0.8s ease-out both;
        animation-delay: 0.2s;
    }

    .tag {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        padding: 0.6rem 1.5rem;
        border: 1px solid rgba(26, 26, 26, 0.2);
        border-radius: 100px;
        color: var(--color-muted);
    }

    h1 {
        font-size: clamp(3rem, 7vw, 5.5rem);
        line-height: 1.05;
        margin-bottom: 2.5rem;
        color: var(--color-black);
        font-weight: 300;
        letter-spacing: -0.04em;
        animation: reveal 0.8s ease-out both;
        animation-delay: 0.4s;
    }

    h1 span {
        font-weight: 500;
    }

    h1 strong {
        font-weight: 500;
    }

    .description {
        font-size: 1.3rem;
        line-height: 1.6;
        color: var(--color-muted);
        margin-bottom: 4rem;
        max-width: 650px;
        animation: reveal 0.8s ease-out both;
        animation-delay: 0.6s;
    }

    .hero-actions {
        display: flex;
        gap: 1.5rem;
        animation: reveal 0.8s ease-out both;
        animation-delay: 0.8s;
    }

    @keyframes reveal {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .btn-primary {
        background-color: var(--color-black);
        color: var(--color-cream);
        padding: 1.25rem 3.5rem;
        border-radius: 6px;
        font-weight: 500;
        font-size: 1.1rem;
        transition: var(--transition);
    }

    .btn-primary:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }

    .btn-secondary {
        border: 1px solid rgba(26, 26, 26, 0.1);
        background-color: rgba(0, 0, 0, 0.02);
        padding: 1.25rem 3.5rem;
        border-radius: 6px;
        font-weight: 500;
        font-size: 1.1rem;
        transition: var(--transition);
    }

    .btn-secondary:hover {
        background-color: rgba(0, 0, 0, 0.05);
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {
        .tag-wrapper {
            margin-top: 6rem;
        }
        .hero-spacer {
            height: 400vh;
        }
        h1 {
            font-size: 2.6rem;
        }
        .description {
            font-size: 1.1rem;
        }
        .hero-actions {
            flex-direction: column;
            width: 100%;
        }
        .btn-primary,
        .btn-secondary {
            text-align: center;
            width: 100%;
        }
    }
</style>

---
import "../styles/global.css";
import CustomCursor from "../components/CustomCursor.astro";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/icono.webp" />
        <meta name="generator" content={Astro.generator} />
        <title>lmdevstudio | Desarrollo Web Minimalista & Elegante</title>
        <!-- Preload font for better performance -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="relative min-h-screen is-loading">
        <!-- Preloader -->
        <div id="main-loader" class="loader-overlay">
            <div class="loader-content">
                <img
                    src="/icono.webp"
                    alt="lmdevstudio Logo"
                    class="loader-logo"
                />
                <div class="loader-line"></div>
            </div>
        </div>

        <CustomCursor />
        <div class="background-overlay"></div>
        <slot />

        <script>
            // Global Reveal on Scroll Logic
            const revealCallback = (
                entries: IntersectionObserverEntry[],
                observer: IntersectionObserver,
            ) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("active");
                    } else {
                        // Remove active class when out of view to re-trigger animation
                        entry.target.classList.remove("active");
                    }
                });
            };

            const revealObserver = new IntersectionObserver(revealCallback, {
                threshold: 0.15,
                rootMargin: "0px 0px -50px 0px",
            });

            // Loader Logic
            window.addEventListener("load", () => {
                const loader = document.getElementById("main-loader");
                const body = document.body;

                if (loader) {
                    setTimeout(() => {
                        loader.classList.add("fade-out");
                        // Desbloquear scroll y quitar clase de carga
                        body.classList.remove("is-loading");

                        setTimeout(() => {
                            loader.style.display = "none";
                        }, 800);
                    }, 1200); // Un poco más de tiempo para apreciar el logo
                }
            });

            // Re-run on navigation (if using view transitions or similar)
            const setupReveals = () => {
                const revealElements = document.querySelectorAll(
                    ".reveal, .reveal-up, .reveal-in",
                );
                revealElements.forEach((el) => revealObserver.observe(el));
            };

            setupReveals();

            // Listen for Astro page loads
            document.addEventListener("astro:after-swap", () => {
                setupReveals();
                // Ocultar loader en transiciones
                const loader = document.getElementById("main-loader");
                if (loader) loader.style.display = "none";
            });
        </script>
    </body>
</html>

<style is:global>
    :root {
        --color-cream: #faf9f6;
        --color-black: #1a1a1a;
        --color-muted: #6b6b6b;
        --max-width: 1400px;
        --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
        background-color: var(--color-cream);
        color: var(--color-black);
        font-family: "Raleway", sans-serif !important;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        cursor: none;
    }

    /* Ocultar el cursor por defecto solo en desktop */
    @media (pointer: fine) {
        * {
            cursor: none !important;
        }
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-family: "Raleway", sans-serif !important;
    }

    /* Animation Utilities */
    .reveal {
        opacity: 0;
        transition: opacity 1.2s cubic-bezier(0.215, 0.61, 0.355, 1);
        will-change: opacity;
    }

    .reveal-up {
        opacity: 0;
        transform: translateY(40px);
        transition:
            opacity 1.2s cubic-bezier(0.215, 0.61, 0.355, 1),
            transform 1.2s cubic-bezier(0.215, 0.61, 0.355, 1);
        will-change: opacity, transform;
    }

    .reveal-in {
        opacity: 0;
        transform: scale(0.96);
        transition:
            opacity 1.2s cubic-bezier(0.215, 0.61, 0.355, 1),
            transform 1.2s cubic-bezier(0.215, 0.61, 0.355, 1);
        will-change: opacity, transform;
    }

    .reveal.active {
        opacity: 1;
    }

    .reveal-up.active,
    .reveal-in.active {
        opacity: 1;
        transform: translate(0) scale(1);
    }

    /* Staggered Delay Utilities */
    .delay-1 {
        transition-delay: 0.1s;
    }
    .delay-2 {
        transition-delay: 0.2s;
    }
    .delay-3 {
        transition-delay: 0.3s;
    }
    .delay-4 {
        transition-delay: 0.4s;
    }
    .delay-5 {
        transition-delay: 0.5s;
    }

    .background-overlay {
        position: fixed;
        inset: 0;
        background:
            radial-gradient(
                circle at 0% 0%,
                rgba(59, 130, 246, 0.03) 0%,
                transparent 50%
            ),
            radial-gradient(
                circle at 100% 100%,
                rgba(59, 130, 246, 0.03) 0%,
                transparent 50%
            );
        pointer-events: none;
        z-index: -1;
    }

    .floating-mascot {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 50;
        opacity: 0.8;
        transition: opacity 0.3s ease;
    }

    .floating-mascot:hover {
        opacity: 1;
    }

    body.is-loading {
        overflow: hidden !important;
    }

    body.is-loading #main-header {
        opacity: 0;
        visibility: hidden;
    }

    /* Loader Styles */
    .loader-overlay {
        position: fixed;
        inset: 0;
        background-color: var(--color-cream);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 99999; /* Por encima de todo, incluyendo el header */
        transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: opacity;
    }

    .loader-overlay.fade-out {
        opacity: 0;
        pointer-events: none;
    }

    .loader-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
    }

    .loader-logo {
        width: 80px;
        height: auto;
        /* Máscara negra: convertimos el logo a negro puro */
        filter: brightness(0);
        animation: logo-pulse 2s ease-in-out infinite;
    }

    .loader-line {
        width: 100px;
        height: 2px;
        background: rgba(0, 0, 0, 0.1);
        position: relative;
        overflow: hidden;
        border-radius: 2px;
    }

    .loader-line::after {
        content: "";
        position: absolute;
        width: 40%;
        height: 100%;
        background: var(--color-black);
        animation: line-slide 1.5s ease-in-out infinite;
    }

    @keyframes logo-pulse {
        0%,
        100% {
            transform: scale(1);
            opacity: 0.8;
        }
        50% {
            transform: scale(1.1);
            opacity: 1;
        }
    }

    @keyframes line-slide {
        0% {
            transform: translateX(-150%);
        }
        100% {
            transform: translateX(250%);
        }
    }

    @media (max-width: 768px) {
        .floating-mascot {
            display: none; /* Ocultar en móvil para no tapar contenido */
        }
    }
</style>
